{
  "name": "psa-rejestr-akcjonariuszy",
  "version": "0.1.0",
  "private": true,
  "description": "Rejestr akcjonariuszy prostych spolek akcyjnych (art. 300(30) i nast. KSH) - Kancelaria Notarialna Lukasza Kozona",
  "main": "serwer.js",
  "type": "commonjs",
  "scripts": {
    "buduj": "node narzedzia/buduj-front.js",
    "buduj-strone": "node narzedzia/buduj-strone.js",
    "prestart": "node narzedzia/buduj-front.js",
    "start": "node serwer.js",
    "dev": "node narzedzia/buduj-front.js --dev",
    "test": "node --test \"testy/*.test.js\"",
    "zrzuty": "playwright test -c testy/e2e/playwright.config.js",
    "e2e": "playwright test -c testy/e2e/e2e.config.js",
    "e2e:malpa": "playwright test -c testy/e2e/e2e-malpa.config.js",
    "dokumentacja": "node narzedzia/dokumentacja-baza.js && node narzedzia/dokumentacja-endpointy.js",
    "test:seed": "node narzedzia/test-seed.js",
    "test:link": "node narzedzia/test-link.js",
    "test:oznacz": "node narzedzia/test-oznacz.js",
    "wzory": "node narzedzia/wzory.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "better-sqlite3": "11.10.0",
    "express": "4.22.3",
    "multer": "1.4.5-lts.2",
    "nodemailer": "10.5.0",
    "pdfkit": "0.20.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
