# Rejestr akcjonariuszy P.S.A. — konfiguracja serwera (skopiuj do .env).
# Dane kancelarii (nazwa, adres, NIP, notariusz, osoby zawierające umowy) ustawia się w aplikacji:
# menu konta → Ustawienia. Tu są tylko ustawienia serwera i sekrety — nigdy nie trafiają do bazy.

# Serwer
PORT=3005
WSPOLNA_BAZA=./dane/kancelaria.db
KATALOG_DOKUMENTOW=./dokumenty
# Publiczny adres portalu — w linkach z e-maili (aktywacja konta) i w powrocie z płatności.
URL_PORTALU=https://rejestr.kancelaria.pl/portal.html
# Za reverse proxy z HTTPS: ciasteczka tylko po HTTPS, nagłówek HSTS.
NODE_ENV=production
# Adres nasłuchu — domyślnie tylko pętla zwrotna (nginx na tym samym serwerze).
# HOST=127.0.0.1
# Adresy, z których działa aplikacja kancelarii (sieć biura; maska CIDR albo adresy po przecinku).
# Z innych adresów trasy pracowników odpowiadają 403. Puste = bez ograniczenia (tylko do pracy lokalnej).
KANCELARIA_ADRESY=

# Sesje — losowy ciąg co najmniej 32 znaków: wklej wynik `openssl rand -hex 32`. Bez niego serwer w produkcji
# nie wystartuje; zmiana wylogowuje wszystkich.
SESJA_SEKRET=
# Pierwszy administrator — przy pierwszym starcie dostaje konto z hasłem tymczasowym (wypisanym w logu serwera).
ADMIN_EMAIL=notariusz@kancelaria.pl

# Poczta — wyłącznie SMTP z TLS (465: TLS od początku; inny port: STARTTLS obowiązkowy).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=rejestr@kancelaria.pl
SMTP_PASS=
SMTP_FROM=Kancelaria Notarialna <rejestr@kancelaria.pl>

# Płatności tpay (portal: opłaty i informacja z rejestru). Bez nich przycisk „Zapłać” zgłasza niedostępność.
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
TPAY_NOTIFICATION_SECRET=
TPAY_API_URL=https://api.tpay.com
# true tylko dla piaskownicy — na produkcji powiadomienia testowe są odrzucane.
TPAY_TRYB_TESTOWY=false

# Odpis z KRS przy zgłoszeniu spółki.
KRS_API_URL=https://api-krs.ms.gov.pl/api/krs

# Portal klienta (formularz publiczny, konta osób działających za spółkę i akcjonariuszy).
PORTAL_WLACZONY=true

# Tryb testowy — wyłącznie poza produkcją, na bazie z `npm run test:seed` (dane fikcyjne, e-maile do skrzynki testowej).
# PSA_TRYB_TESTOWY=1
# PSA_BAZA_TESTOWA=./dane-testowe/kancelaria-testowa.db
