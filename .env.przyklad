# Rejestr akcjonariuszy P.S.A. - zmienne srodowiskowe (sekcja 12 specyfikacji).
# Skopiuj do `.env` i uzupelnij. Plik `.env` NIE trafia do repozytorium.

# Port modulu (kanon: 3005)
PORT=3005

# Sciezka pliku wspolnej bazy SQLite kancelarii
WSPOLNA_BAZA=./dane/kancelaria.db

# Katalog plikow spraw (poza katalogiem publicznym) - uzywany od sprintu 2
KATALOG_DOKUMENTOW=./dokumenty

# Konto administratora modulu - przy pierwszym starcie z pusta tabela
# psa_uzytkownicy zaklada sie automatycznie konto z tym adresem i losowym
# haslem tymczasowym, wypisanym JEDEN raz w logu startu serwera.
ADMIN_EMAIL=lukasz@kancelaria.pl

# Klucz podpisu sesji (HMAC-SHA256, logowanie pracownikow i portalu klienta).
# Bez niego serwer wystartuje, ale wygeneruje sekret tymczasowy - wszystkie
# sesje wygasna po restarcie. USTAWIC PRZED WDROZENIEM.
SESJA_SEKRET=zmien-mnie-przed-wdrozeniem

# Wysylka zawiadomien - uzywana od sprintu 2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Otwarte API KRS (rejestr przedsiebiorcow)
KRS_API_URL=https://api-krs.ms.gov.pl/api/krs

# Portal klienta - domyslnie wylaczony nawet po sprincie 3 (bezpieczny
# domyslny stan produkcyjny). Wlacz swiadomie po ustaleniu wariantu
# wdrozenia (sekcja 2 specyfikacji) i zaproszeniu pierwszych kont.
PORTAL_WLACZONY=false

# Publiczny adres portalu klienta - link aktywacyjny w mailu zapraszajacym
# (etap 3B) musi wskazywac na adres widoczny dla klienta, nie na localhost.
URL_PORTALU=https://rejestr.kancelaria.pl/portal.html

# Strefa czasowa serwera - decyduje o godzinie wpisu na zawiadomieniach
TZ=Europe/Warsaw

# Dane kancelarii na naglowki dokumentow (rdzen_kancelaria)
KANCELARIA_NAZWA=Kancelaria Notarialna Lukasz Kozon
KANCELARIA_ADRES=
KANCELARIA_MIEJSCOWOSC=
KANCELARIA_TELEFON=
KANCELARIA_EMAIL=

# Te same dane, ale ATOMOWO - czytaja je wzory .docx z wzory/ (sesja 8, blok A2).
# "z siedziba w Miescie" sklada sie inaczej w kazdym pismie, wiec skladnik
# miejscownika nie da sie wyliczyc algorytmem - trzeba go podac wprost.
KANCELARIA_ULICA=
KANCELARIA_KOD=
KANCELARIA_MIASTO=
KANCELARIA_MIASTO_MIEJSCOWNIK=
KANCELARIA_NIP=
KANCELARIA_REGON=
NOTARIUSZ_MIANOWNIK=Łukasz Kozon
NOTARIUSZ_DOPELNIACZ=
NOTARIUSZ_NARZEDNIK=
PODPISUJACY_FUNKCJA=Notariusz
PODPISUJACY_MIANOWNIK=
